{
  "id": "com.fd.djaja.sap.sac.excelcom",
  "version": "5.0.0",
  "name": "CompanyUpload Advanced",
  "description": "Advanced Excel upload widget with preview and SAC validation feedback",
  "newInstancePrefix": "CompanyUploadAdvanced",
  "icon": "data:image/png;base64,",
  "vendor": "Arnav",
  "eula": "",
  "license": "",
  "imports": ["input-controls"],
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-fd-djaja-sap-sac-excelcom",
      "url": "https://sacplanning2025.github.io/Company_widget/excelcom.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-fd-djaja-sap-sac-excelcom-aps",
      "url": "https://sacplanning2025.github.io/Company_widget/aps_excelcom.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "metadata": { "type": "string", "default": "" },
    "title": { "type": "string", "default": "Excel Upload" },
    "subtitle": { "type": "string", "default": "Upload and validate Excel file" },
    "icon": { "type": "string", "default": "" },
    "unit": { "type": "string", "default": "" },
    "footer": { "type": "string", "default": "Supported template: Sheet1 with columns ID, DESCRIPTION, H1, costcenter" },
    "errorlogfilename": { "type": "string", "default": "Excel_Upload_Error_Log.csv" },
    "templatefilename": { "type": "string", "default": "New_Position_Creation_V2.1.xlsm" },
    "templateurl": { "type": "string", "default": "https://raw.githubusercontent.com/sacplanning2025/Company_widget/main/New_Position_Creation_V2.1.xlsm" },
    "requiredcolumns": { "type": "string", "default": "ID,DESCRIPTION,H1,costcenter" },
    "maxrows": { "type": "integer", "default": 2000 },
    "previewrows": { "type": "integer", "default": 50 },
    "allowcsv": { "type": "boolean", "default": true },
    "autovalidate": { "type": "boolean", "default": true },
    "showpreview": { "type": "boolean", "default": true },
    "showlogs": { "type": "boolean", "default": true },
    "validationresult": { "type": "string", "default": "true" },
    "validationerrors": { "type": "string", "default": "[]" },
    "lastevent": { "type": "string", "default": "" },
    "invalidcount": { "type": "integer", "default": 0 },
    "validcount": { "type": "integer", "default": 0 },
    "rowcount": { "type": "integer", "default": 0 }
  },
  "methods": {
    "getTitle": { "returnType": "string", "parameters": [], "body": "return this.title;" },
    "setTitle": { "parameters": [{ "name": "value", "type": "string" }], "body": "this.title = value;" },
    "getSubTitle": { "returnType": "string", "parameters": [], "body": "return this.subtitle;" },
    "setSubTitle": { "parameters": [{ "name": "value", "type": "string" }], "body": "this.subtitle = value;" },
    "getUnit": { "returnType": "string", "parameters": [], "body": "return this.unit;" },
    "setUnit": { "parameters": [{ "name": "value", "type": "string" }], "body": "this.unit = value;" },
    "getValidationResult": { "returnType": "string", "parameters": [], "body": "return this.validationresult;" },
    "setValidationResult": { "parameters": [{ "name": "value", "type": "string" }], "body": "this.validationresult = value;" },
    "getValidationErrors": { "returnType": "string", "parameters": [], "body": "return this.validationerrors;" },
    "setValidationErrors": { "parameters": [{ "name": "value", "type": "string" }], "body": "this.validationerrors = value;" },
    "getLastEvent": { "returnType": "string", "parameters": [], "body": "return this.lastevent;" },
    "setLastEvent": { "parameters": [{ "name": "value", "type": "string" }], "body": "this.lastevent = value;" }
  },
  "events": {
    "onStart": {
      "description": "Triggered after upload parsing is completed."
    },
    "onValidate": {
      "description": "Triggered when validation is refreshed."
    },
    "onClear": {
      "description": "Triggered when widget is cleared."
    }
  }
}
