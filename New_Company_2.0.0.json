{
  "id": "com.fd.djaja.sap.sac.excelcom",
  "version": "5.0.0",
  "name": "CompanyUpload Advanced",
  "description": "Advanced Excel upload widget with preview, validation, SAC feedback and error highlighting",
  "newInstancePrefix": "CompanyUploadAdvanced",
  "icon": "data:image/png;base64,",
  "vendor": "Arnav",
  "eula": "",
  "license": "",
  "imports": ["input-controls"],
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-fd-djaja-sap-sac-excelcom",
      "url": "https://sacplanning2025.github.io/Company_widget/excelcom.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-fd-djaja-sap-sac-excelcom-aps",
      "url": "https://sacplanning2025.github.io/Company_widget/aps_excelcom.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "metadata": {
      "type": "string",
      "description": "For internal use",
      "default": ""
    },
    "title": {
      "type": "string",
      "description": "Widget title",
      "default": "Excel Upload"
    },
    "subtitle": {
      "type": "string",
      "description": "Widget subtitle",
      "default": "Upload and validate Excel file"
    },
    "icon": {
      "type": "string",
      "description": "Optional icon",
      "default": ""
    },
    "unit": {
      "type": "string",
      "description": "Valid output payload",
      "default": ""
    },
    "footer": {
      "type": "string",
      "description": "Footer note",
      "default": "Supported template: Sheet1 with columns ID, DESCRIPTION, H1, costcenter"
    },
    "errorlogfilename": {
      "type": "string",
      "description": "Error log download filename",
      "default": "Excel_Upload_Error_Log.csv"
    },
    "templatefilename": {
      "type": "string",
      "description": "Template filename",
      "default": "New_Position_Creation_V2.1.xlsm"
    },
    "templateurl": {
      "type": "string",
      "description": "Template file URL",
      "default": "https://raw.githubusercontent.com/sacplanning2025/Company_widget/main/New_Position_Creation_V2.1.xlsm"
    },
    "requiredcolumns": {
      "type": "string",
      "description": "Comma separated required columns",
      "default": "ID,DESCRIPTION,H1,costcenter"
    },
    "maxrows": {
      "type": "integer",
      "description": "Maximum valid rows allowed",
      "default": 2000
    },
    "previewrows": {
      "type": "integer",
      "description": "Preview row count",
      "default": 50
    },
    "allowcsv": {
      "type": "boolean",
      "description": "Allow csv files",
      "default": true
    },
    "autovalidate": {
      "type": "boolean",
      "description": "Auto validate on upload",
      "default": true
    },
    "showpreview": {
      "type": "boolean",
      "description": "Show preview grid",
      "default": true
    },
    "showlogs": {
      "type": "boolean",
      "description": "Show process log",
      "default": true
    },
    "validationresult": {
      "type": "string",
      "description": "Validation result from SAC script",
      "default": "true"
    },
    "validationerrors": {
      "type": "string",
      "description": "Validation errors JSON from SAC script",
      "default": "[]"
    },
    "lastevent": {
      "type": "string",
      "description": "Internal event flag",
      "default": ""
    },
    "invalidcount": {
      "type": "integer",
      "description": "Invalid row count",
      "default": 0
    },
    "validcount": {
      "type": "integer",
      "description": "Valid row count",
      "default": 0
    },
    "rowcount": {
      "type": "integer",
      "description": "Total row count",
      "default": 0
    }
  },
  "methods": {
    "getTitle": {
      "returnType": "string",
      "description": "Get title",
      "parameters": [],
      "body": "return this.title;"
    },
    "setTitle": {
      "description": "Set title",
      "parameters": [
        {
          "name": "value",
          "type": "string",
          "description": "New title"
        }
      ],
      "body": "this.title = value;"
    },
    "getSubTitle": {
      "returnType": "string",
      "description": "Get subtitle",
      "parameters": [],
      "body": "return this.subtitle;"
    },
    "setSubTitle": {
      "description": "Set subtitle",
      "parameters": [
        {
          "name": "value",
          "type": "string",
          "description": "New subtitle"
        }
      ],
      "body": "this.subtitle = value;"
    },
    "getUnit": {
      "returnType": "string",
      "description": "Get valid payload JSON",
      "parameters": [],
      "body": "return this.unit;"
    },
    "setUnit": {
      "description": "Set valid payload JSON",
      "parameters": [
        {
          "name": "value",
          "type": "string",
          "description": "Payload"
        }
      ],
      "body": "this.unit = value;"
    },
    "getValidationResult": {
      "returnType": "string",
      "description": "Get validation result",
      "parameters": [],
      "body": "return this.validationresult;"
    },
    "setValidationResult": {
      "description": "Set validation result",
      "parameters": [
        {
          "name": "value",
          "type": "string",
          "description": "true or false"
        }
      ],
      "body": "this.validationresult = value;"
    },
    "getValidationErrors": {
      "returnType": "string",
      "description": "Get validation errors JSON",
      "parameters": [],
      "body": "return this.validationerrors;"
    },
    "setValidationErrors": {
      "description": "Set validation errors JSON",
      "parameters": [
        {
          "name": "value",
          "type": "string",
          "description": "JSON array of row/cell errors"
        }
      ],
      "body": "this.validationerrors = value;"
    },
    "getLastEvent": {
      "returnType": "string",
      "description": "Get last widget event",
      "parameters": [],
      "body": "return this.lastevent;"
    },
    "setLastEvent": {
      "description": "Set last event",
      "parameters": [
        {
          "name": "value",
          "type": "string",
          "description": "Event name"
        }
      ],
      "body": "this.lastevent = value;"
    },
    "validate": {
      "returnType": "string",
      "description": "Trigger validation display refresh",
      "parameters": [],
      "body": "return this.validationresult;"
    },
    "clear": {
      "description": "Clear upload content",
      "parameters": [],
      "body": "this.clear && this.clear();"
    }
  },
  "events": {
    "onStart": {
      "description": "Triggered after upload parsing is completed and valid payload is prepared."
    },
    "onValidate": {
      "description": "Triggered when validation result/errors are applied from SAC."
    },
    "onClear": {
      "description": "Triggered when widget content is cleared."
    }
  }
}
